<!-- 工单 31：Title 运行时以 csproj 版本号重设，此处为设计器回退值 -->
<Window x:Class="ImageUpscaleGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image-Upscale 图像超分" Height="660" Width="920"
        MinWidth="660" MinHeight="540"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
    <Window.Resources>
        <!-- 工单 12：经典主题下控件文字默认顶对齐，显式垂直居中，不依赖系统主题 -->
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 输入（工单 11：可编辑；输入框自身支持拖入） -->
        <GroupBox Grid.Row="0" Header="输入（支持拖入文件或文件夹）" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="浏览…" Width="80" Margin="6,0,0,0" Click="OnBrowse"/>
                <TextBox x:Name="InputBox" Background="White" Height="28"
                         PreviewDragOver="OnInputPreviewDragOver" PreviewDrop="OnInputPreviewDrop"/>
            </DockPanel>
        </GroupBox>

        <!-- 模型（工单 21：A-Z 排序 / 不再显示类型与架构；v0.2.4 移除"现有模型："前缀） -->
        <GroupBox Grid.Row="1" Header="模型" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <ComboBox x:Name="ModelBox" Width="320" SelectionChanged="OnModelChanged"/>
            </WrapPanel>
        </GroupBox>

        <!-- 尺寸模式（工单 19：WrapPanel 窄窗口自动换行） -->
        <GroupBox Grid.Row="2" Header="尺寸模式" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <RadioButton x:Name="ModeScale" GroupName="sizemode" IsChecked="True"
                             Content="倍率" VerticalAlignment="Center"/>
                <ComboBox x:Name="ScaleBox" Width="80" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeWidth" GroupName="sizemode" Content="指定宽" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Width="80" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeHeight" GroupName="sizemode" Content="指定高" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Width="80" Margin="6,0,0,0"/>
            </WrapPanel>
        </GroupBox>

        <!-- 降噪 + 输出 -->
        <GroupBox Grid.Row="3" Header="降噪与输出" Padding="8" Margin="0,0,0,8">
            <!-- v0.2.5：标签与控件各自成组（StackPanel），WrapPanel 窄窗口整体换行，不再拆散"质量："与其滑条/输入框 -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="降噪：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DenoiseBox" Width="90" Margin="0,0,6,0"/>
                    <TextBlock x:Name="DenoiseHint" Text="该模型不支持降噪" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出格式：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="FormatBox" Width="90" Margin="0,0,16,0" SelectedIndex="0">
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="WebP"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="质量：" VerticalAlignment="Center"/>
                    <Slider x:Name="QualitySlider" Width="160" Minimum="0" Maximum="100"
                            Value="90" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnQualitySliderChanged"/>
                    <!-- 工单 13：质量支持手动输入 -->
                    <TextBox x:Name="QualityInput" Width="48" Margin="8,0,0,0"
                             TextChanged="OnQualityInputChanged" LostFocus="OnQualityInputLostFocus"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>

        <!-- 开始 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="开始处理" Width="140" Height="34"
                    FontSize="14" Click="OnStart"/>
            <ProgressBar x:Name="Progress" Width="360" Height="20" Margin="16,0,0,0"
                         Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 日志（工单 18：分隔条可调高度；工单 17：TextBox 可复制、自动换行） -->
        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      Background="Transparent"/>
        <GroupBox Grid.Row="6" Header="日志" Padding="4" MinHeight="80">
            <!-- 工单 34：日志文本显式顶对齐；工单 35：字体继承全局默认（与其余 UI 同源，中文为微软雅黑），字号 16（v0.2.4 由 14 上调） -->
            <TextBox x:Name="LogBox" FontSize="16" VerticalContentAlignment="Top"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="White"/>
        </GroupBox>
    </Grid>
</Window>
