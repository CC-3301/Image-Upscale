<Window x:Class="ImageUpscaleGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image-Upscale 图像超分" Height="660" Width="920"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 输入 -->
        <GroupBox Grid.Row="0" Header="输入（支持拖入文件或文件夹）" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="浏览…" Width="80" Click="OnBrowse"/>
                <TextBox x:Name="InputBox" IsReadOnly="True" Background="White"
                         VerticalContentAlignment="Center" Height="28"/>
            </DockPanel>
        </GroupBox>

        <!-- 模型 -->
        <GroupBox Grid.Row="1" Header="模型" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="打包模型：" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModelBox" Width="320" Height="28" SelectionChanged="OnModelChanged"/>
                <TextBlock x:Name="ModelGroupText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- 尺寸模式 -->
        <GroupBox Grid.Row="2" Header="尺寸模式（三选一）" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeScale" GroupName="sizemode" IsChecked="True"
                             Content="倍率" VerticalAlignment="Center"/>
                <ComboBox x:Name="ScaleBox" Width="80" Height="28" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeWidth" GroupName="sizemode" Content="指定宽" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Width="80" Height="28" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeHeight" GroupName="sizemode" Content="指定高" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Width="80" Height="28" Margin="6,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 降噪 + 输出 -->
        <GroupBox Grid.Row="3" Header="降噪与输出" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="降噪：" VerticalAlignment="Center"/>
                <ComboBox x:Name="DenoiseBox" Width="90" Height="28" Margin="0,0,24,0"/>
                <TextBlock Text="输出格式：" VerticalAlignment="Center"/>
                <ComboBox x:Name="FormatBox" Width="90" Height="28" Margin="0,0,24,0" SelectedIndex="0">
                    <ComboBoxItem Content="JPG"/>
                    <ComboBoxItem Content="PNG"/>
                    <ComboBoxItem Content="WebP"/>
                </ComboBox>
                <TextBlock Text="质量：" VerticalAlignment="Center"/>
                <Slider x:Name="QualitySlider" Width="160" Minimum="0" Maximum="100"
                        Value="90" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" ValueChanged="OnQualityChanged"/>
                <TextBlock x:Name="QualityValue" Text="90" Width="32" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- 开始 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="开始处理" Width="140" Height="34"
                    FontSize="14" Click="OnStart"/>
            <ProgressBar x:Name="Progress" Width="360" Height="20" Margin="16,0,0,0"
                         Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 日志 -->
        <GroupBox Grid.Row="5" Header="处理日志" Padding="4" Height="220">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </Grid>
</Window>
