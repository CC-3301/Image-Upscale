<!-- 工单 31：Title 运行时以 csproj 版本号重设，此处为设计器回退值 -->
<Window x:Class="ImageUpscaleGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageUpscale 图像超分" Height="660" Width="920"
        MinWidth="780" MinHeight="540"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <!-- 工单 12：经典主题下控件文字默认顶对齐，显式垂直居中，不依赖系统主题 -->
        <Style TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 工单 18：分隔条拖动到极限不得把「开始」按钮挤掉 -->
            <RowDefinition Height="Auto" MinHeight="42"/>
            <RowDefinition Height="Auto"/>
            <!-- 工单 18：日志区（上限 = 60% 窗口高度，由 OnWindowSizeChanged 设定；下限见 GroupBox MinHeight） -->
            <RowDefinition x:Name="LogRow" Height="*"/>
        </Grid.RowDefinitions>

        <!-- 输入（工单 11：可编辑；输入框自身支持拖入） -->
        <GroupBox Grid.Row="0" Header="输入（支持拖入文件或文件夹）" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="浏览…" Width="80" Margin="6,0,0,0" Click="OnBrowse"/>
                <TextBox x:Name="InputBox" Background="White" Height="28"
                         TextChanged="OnInputTextChanged"
                         PreviewDragOver="OnInputPreviewDragOver" PreviewDrop="OnInputPreviewDrop"/>
            </DockPanel>
        </GroupBox>

        <!-- 模型（工单 21：A-Z 排序 / 不再显示类型与架构；v0.2.4 移除"现有模型："前缀）
             工单 51：「降采样方式」从「降噪与输出」行挪到此处，与模型下拉同行
             工单 42 实测："Catmull-Rom"在 100px 下被裁；实测控件自身开销 28px + 文字 76.1px（微软雅黑 UI 12px）= 104.1px，
             故下拉宽度定为 106px（115 嫌宽、100 裁字）；本行实测宽度 520px（口径同下方「降噪与输出」注释：
             780×540 窗口、UIAutomation 读子控件矩形），不换行 -->
        <GroupBox Grid.Row="1" Header="模型" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <ComboBox x:Name="ModelBox" Width="320" SelectionChanged="OnModelChanged"/>
                <TextBlock Text="降采样方式：" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <!-- 工单 42：缩小路径的重采样滤镜（默认 Lanczos）；工单 43：放大不再插值，改由模型多轮完成 -->
                <ComboBox x:Name="DownFilterBox" Width="106"/>
            </WrapPanel>
        </GroupBox>

        <!-- 尺寸模式（工单 19：WrapPanel 窄窗口自动换行） -->
        <GroupBox Grid.Row="2" Header="尺寸模式" Padding="8" Margin="0,0,0,8">
            <WrapPanel>
                <RadioButton x:Name="ModeScale" GroupName="sizemode" IsChecked="True"
                             Content="倍率" VerticalAlignment="Center"/>
                <ComboBox x:Name="ScaleBox" Width="80" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeWidth" GroupName="sizemode" Content="指定宽" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Width="80" Margin="6,0,20,0"/>
                <RadioButton x:Name="ModeHeight" GroupName="sizemode" Content="指定高" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Width="80" Margin="6,0,0,0"/>
            </WrapPanel>
        </GroupBox>

        <!-- 降噪 + 输出（工单 51：第四组"降采样方式"已挪到「模型」栏，原位改为「文件添加扩展名」开关） -->
        <GroupBox Grid.Row="3" Header="降噪与输出" Padding="8" Margin="0,0,0,8">
            <!-- v0.2.4：整体一行不换行（维护者定案，用 StackPanel 非 WrapPanel）
                 工单 42：第四组为“降采样方式”（工单 51 已挪到「模型」栏）
                 工单 51：第四组改为「文件添加扩展名」下拉。实测口径（可复现）——
                   窗口 780×540（MinWidth）；模型 digital-art-4x（唯一不支持降噪的模型，“该模型不支持降噪”提示可见 = 最坏情况）；
                   用 UIAutomation 读本组全部子控件的 BoundingRectangle：
                   行宽 = 最右子控件右边缘 − 本组内容区左边缘（GroupBox 左边缘 + padding 8）；
                   可用宽 = GroupBox 宽 − 左右 padding 16（本尺寸下 = 736 − 16 = 720）。
                 实测：行宽 716px ≤ 可用宽 720px（余 4px）→ 不裁剪，MinWidth 780 不变。
                 与历史数字的关系（不让仓库并存两套口径）：
                   ① 控件替换本身：改前同一行（末位为降采样方式组）同口径实测 726px，换成更窄的本组后 716px（−10px）；
                   ② 旧注释的 758px/764px 与工单 42 的 734px 口径未写明，它们 ≈ 内容区内的行占位（首子控件左边缘→
                      末子控件右边缘，本尺寸下 720px）再加 38/44px 内容区外余量；758 与 764 出现在同一段旧注释里、
                      描述同一行却相差 6px，自相矛盾；734 与 758 相差 24px 恰等于「降采样：」→「降采样方式：」的
                      标签增量，说明这两个数同属那套旧口径 → 与上面的“行宽”不是同一口径，不要混用；本票起以本口径为准。
                 下拉宽 72px（“开/关”单字 12px + 控件开销 28px = 40px 即可完整显示，取 72px 与同行下拉观感一致）；
                 下拉项由 SettingsStore.AddSuffixLabels 填充（单一定义来源，本 XAML 不写死项） -->
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="降噪：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DenoiseBox" Width="90" Margin="0,0,6,0"/>
                    <TextBlock x:Name="DenoiseHint" Text="该模型不支持降噪" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出格式：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="FormatBox" Width="90" Margin="0,0,16,0" SelectedIndex="0">
                        <ComboBoxItem Content="JPG"/>
                        <ComboBoxItem Content="PNG"/>
                        <ComboBoxItem Content="WebP"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输出质量：" VerticalAlignment="Center"/>
                    <!-- 工单 13 → v0.2.4：去滑条，仅手动输入（0-100），非法输入失焦回退 -->
                    <TextBox x:Name="QualityInput" Width="48" Text="90" Margin="8,0,0,0"
                             TextChanged="OnQualityInputChanged" LostFocus="OnQualityInputLostFocus"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文件添加扩展名：" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <!-- 工单 51：产物名后缀段开关（工单 50 的 no-rename 开关）；只对文件输入生效，
                         文件夹/空/无效路径时由代码切到「开」并灰置（工单 50 定案 1）；
                         项不写在这里 —— 由 SettingsStore.AddSuffixLabels 填充（工单 41/42 的单一定义来源惯例） -->
                    <ComboBox x:Name="AddSuffixBox" Width="72" SelectionChanged="OnAddSuffixChanged"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 开始 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartButton" Content="开始处理" Width="140" Height="34"
                    FontSize="14" Click="OnStart"/>
            <ProgressBar x:Name="Progress" Width="360" Height="20" Margin="16,0,0,0"
                         Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 日志（工单 18：分隔条可调高度；工单 17：TextBox 可复制、自动换行） -->
        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      Background="Transparent"/>
        <GroupBox Grid.Row="6" Header="日志" Padding="4" MinHeight="80">
            <!-- 工单 34：日志文本显式顶对齐；工单 35：字体继承全局默认（与其余 UI 同源，中文为微软雅黑），字号 16（v0.2.4 由 14 上调） -->
            <TextBox x:Name="LogBox" FontSize="16" VerticalContentAlignment="Top"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="White"/>
        </GroupBox>
    </Grid>
</Window>
