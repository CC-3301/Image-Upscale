<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ImageUpscale</AssemblyName>
    <RootNamespace>ImageUpscaleGui</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 工单 31：版本号唯一来源；GUI 标题运行时读取 -->
    <Version>0.2.5</Version>
    <!-- 工单 28：不生成 pdb（bin/obj/publish 全链路） -->
    <DebugType>none</DebugType>
    <!-- 工单 32：IU 字母标识（v1）作为 exe 文件图标 -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <!-- 工单 16：便携 zip 瘦身 —— 仅中文卫星资源，运行时收敛进单文件 exe -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 工单 27：引擎 DLL 随构建/发布携带；EngineDll 可被打包脚本覆盖（-p:EngineDll=...） -->
  <PropertyGroup>
    <EngineDll Condition="'$(EngineDll)' == ''">$(MSBuildThisFileDirectory)..\bld\iu_engine.dll</EngineDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EngineDll)')">
    <Content Include="$(EngineDll)" Link="iu_engine.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- 工单 32：窗口/任务栏图标（与 exe 文件图标同一资源） -->
  <ItemGroup>
    <Resource Include="assets\app.ico" />
  </ItemGroup>

</Project>
